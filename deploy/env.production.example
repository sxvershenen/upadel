# Public origins. Replace both example domains before deployment.
PUBLIC_WEB_URL=https://unlimpadel.ru
PUBLIC_CMS_URL=https://cms.unlimpadel.ru
# Normally the CMS origin; LAN development may point this at the web same-origin proxy.
PUBLIC_CONTENT_URL=https://cms.unlimpadel.ru
PUBLIC_SITE_URL=https://unlimpadel.ru

# Web SSR talks to Payload over loopback; browsers use PUBLIC_CMS_URL for media and forms.
CMS_URL=http://127.0.0.1:3000
CMS_PROXY_URL=

# PostgreSQL and Payload secrets.
DATABASE_URL=postgres://unlim:replace-with-db-password@127.0.0.1:5432/unlim
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PREVIEW_SECRET=replace-with-a-different-32-character-secret
PAYLOAD_ADMIN_ROUTE=/urp-panel

# Initial owner account. Set ADMIN_UPDATE_PASSWORD=true only for an intentional rotation.
ADMIN_USERNAME=URP
ADMIN_EMAIL=owner@unlimpadel.ru
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_UPDATE_PASSWORD=false

# Browser origins allowed to submit leads and analytics.
LEAD_ALLOWED_ORIGINS=https://unlimpadel.ru
ANALYTICS_ALLOWED_ORIGINS=https://unlimpadel.ru
ANALYTICS_JOB_SECRET=replace-with-a-different-32-character-secret

# Optional lead notifications. Leave the corresponding *_ENABLED setting off in CMS until configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VK_ACCESS_TOKEN=
VK_PEER_ID=

# Runtime bindings consumed by systemd units.
CMS_HOST=127.0.0.1
CMS_PORT=3000
WEB_HOST=127.0.0.1
WEB_PORT=4321

# Backup helper variables.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=unlim
PGUSER=unlim
PGPASSWORD=replace-with-db-password
BACKUP_DIR=/srv/backups/unlim
MEDIA_DIR=/srv/unlim/shared/media
ENV_FILE=/srv/unlim/shared/.env.production
RELEASE_DIR=/srv/unlim/current
