[Unit]
Description=UNLIM %i production backup
After=postgresql.service

[Service]
Type=oneshot
User=unlim
Group=unlim
WorkingDirectory=/srv/unlim/current
EnvironmentFile=/srv/unlim/shared/.env.production
Environment=BACKUP_NAME=%i
ExecStart=/srv/unlim/current/deploy/backup.sh
NoNewPrivileges=true
PrivateTmp=true
