---
import type { CatalogDTO } from '@unlim/content-contract'
import { parseCatalogQuery, catalogPath } from '@unlim/content-contract'
import { CatalogPage } from '../../catalog/CatalogPage'
import { loadCatalog } from '../../content/loadCatalog'
import PublicErrorPage from '../../components/PublicErrorPage.astro'
import SiteLayout from '../../layouts/SiteLayout.astro'
import { publicRouteError } from '../../lib/publicRouteError'
import { catalogStructuredData, resolveCanonicalURL } from '../../seo/structuredData'

const kind = 'blog' as const
const query = parseCatalogQuery(kind, Astro.url.searchParams)
let dto: CatalogDTO | null = null
let routeError: ReturnType<typeof publicRouteError> | null = null
try { dto = await loadCatalog(import.meta.env.CMS_URL, kind, undefined, query) }
catch (error) { routeError = publicRouteError(error); Astro.response.status = routeError.status }
const publicOrigin = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin
const filtered = Object.keys(query).some((key) => key !== 'page')
const canonical = dto ? resolveCanonicalURL(publicOrigin, catalogPath(kind, dto.query), !filtered && query.page === 1 ? dto.page.seo.canonical : null) : null
const title = dto ? `${dto.page.seo.title ?? dto.page.title}${query.page > 1 ? ` — страница ${query.page}` : ''}` : undefined
const robots = dto ? (filtered && dto.page.seo.robots === 'index-follow' ? 'noindex-follow' : dto.page.seo.robots) : 'noindex-nofollow'
---
{dto && canonical ? <SiteLayout site={dto.site} title={title} description={dto.page.seo.description ?? dto.page.intro} canonical={canonical} robots={robots} socialImage={dto.page.seo.socialImage?.url} preloadImage={dto.page.hero.media} structuredData={catalogStructuredData(dto, publicOrigin, canonical)} webmasterVerification={dto.site.analytics.vendors.webmasterVerification}><CatalogPage client:load dto={dto} /></SiteLayout> : routeError && <SiteLayout title={routeError.title} description={routeError.message} robots="noindex-nofollow"><PublicErrorPage {...routeError} /></SiteLayout>}
