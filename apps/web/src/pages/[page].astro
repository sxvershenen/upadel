---
import type { ThematicPageDTO } from '@unlim/content-contract'
import { ThematicPage } from '../thematic/ThematicPage'
import { loadPage, type ThematicPageKind } from '../content/loadPage'
import SiteLayout from '../layouts/SiteLayout.astro'

export async function getStaticPaths() {
  const kinds: ThematicPageKind[] = ['prices', 'training', 'gift', 'courts', 'gallery', 'about', 'policy', 'oferta']
  return Promise.all(kinds.map(async (kind) => ({ params: { page: kind }, props: { dto: await loadPage(import.meta.env.CMS_URL, kind) } })))
}
const { dto } = Astro.props as { dto: ThematicPageDTO }
const isGift = dto.kind === 'gift'
const pageTitle = isGift
  ? 'Подарочный сертификат на падел в Москве — тренировки и аренда корта | UNLIM'
  : (dto.page.seo.title ?? dto.page.title)

const pageDescription = isGift
  ? 'Подарочный сертификат на игру в падел в клубе UNLIM RIGA PADEL: аренда панорамных кортов Jubo, тренировки с тренером и экипировка Varlion. Электронный за 2 минуты или в премиальном боксе. Срок действия 1 год.'
  : (dto.page.seo.description ?? dto.page.intro)

const socialImage = isGift
  ? '/images/gift/card.jpg'
  : dto.page.seo.socialImage?.url
---
<SiteLayout site={dto.site} title={pageTitle} description={pageDescription} canonical={dto.page.seo.canonical} robots={dto.page.seo.robots} socialImage={socialImage} webmasterVerification={dto.site.analytics.vendors.webmasterVerification}>
  <ThematicPage client:load dto={dto} />
</SiteLayout>
