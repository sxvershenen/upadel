---
import type { TournamentDetailDTO } from '@unlim/content-contract'
import { DetailPage } from '../../catalog/DetailPage'
import { loadCatalog, loadDetail } from '../../content/loadCatalog'
import SiteLayout from '../../layouts/SiteLayout.astro'
export async function getStaticPaths() { const catalog = await loadCatalog(import.meta.env.CMS_URL, 'tournaments'); return Promise.all(catalog.items.map(async ({ slug }) => ({ params: { slug }, props: { dto: await loadDetail(import.meta.env.CMS_URL, 'tournaments', slug) as TournamentDetailDTO } }))) }
const { dto } = Astro.props as { dto: TournamentDetailDTO }
---
<SiteLayout title={dto.item.seo.title ?? dto.item.title} description={dto.item.seo.description ?? dto.item.description} canonical={dto.item.seo.canonical} robots={dto.item.seo.robots} socialImage={dto.item.seo.socialImage?.url ?? dto.item.image?.url} webmasterVerification={dto.site.analytics.vendors.webmasterVerification}><DetailPage client:load dto={dto} /></SiteLayout>
