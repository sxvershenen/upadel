---
import type { TournamentDetailDTO } from '@unlim/content-contract'
import { DetailPage } from '../../catalog/DetailPage'
import { CatalogLoadError, loadDetail } from '../../content/loadCatalog'
import SiteLayout from '../../layouts/SiteLayout.astro'

export const prerender = false

const slug = Astro.params.slug
if (!slug) throw new CatalogLoadError('Tournament slug is required.')
const dto = await loadDetail(import.meta.env.CMS_URL, 'tournaments', slug) as TournamentDetailDTO
---
<SiteLayout site={dto.site} title={dto.item.seo.title ?? dto.item.title} description={dto.item.seo.description ?? dto.item.description} canonical={dto.item.seo.canonical} robots={dto.item.seo.robots} socialImage={dto.item.seo.socialImage?.url ?? dto.item.image?.url} webmasterVerification={dto.site.analytics.vendors.webmasterVerification}><DetailPage client:load dto={dto} /></SiteLayout>
