---
import App from '../App'
import { loadHomepage } from '../content/loadHomepage'
import SiteLayout from '../layouts/SiteLayout.astro'

const content = await loadHomepage({ cmsURL: import.meta.env.CMS_URL })
---

<SiteLayout site={content.site} title={content.seo.title ?? undefined} description={content.seo.description ?? undefined} webmasterVerification={content.site.analytics.vendors.webmasterVerification}>
  <App client:load content={content} />
</SiteLayout>
