---
import { padelCourtZakazRoute } from '@unlim/content-contract'
import { loadHomepage } from '../content/loadHomepage'
import { PadelCourtZakazPage } from '../landing/PadelCourtZakazPage'
import SiteLayout from '../layouts/SiteLayout.astro'

const content = await loadHomepage({ cmsURL: import.meta.env.CMS_URL })
const canonical = new URL(padelCourtZakazRoute.path, import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin).toString()
---

<SiteLayout
  title={padelCourtZakazRoute.title}
  description={padelCourtZakazRoute.description}
  canonical={canonical}
  robots={padelCourtZakazRoute.robots}
  socialImage={padelCourtZakazRoute.socialImage}
  webmasterVerification={content.site.analytics.vendors.webmasterVerification}
>
  <PadelCourtZakazPage client:load site={content.site} />
</SiteLayout>
