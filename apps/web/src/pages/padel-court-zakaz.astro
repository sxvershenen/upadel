---
import { loadPadelCourtZakazPage } from '../content/loadPage'
import { PadelCourtZakazPage } from '../landing/PadelCourtZakazPage'
import SiteLayout from '../layouts/SiteLayout.astro'
import { courtServiceStructuredData, resolveCanonicalURL } from '../seo/structuredData'

const content = await loadPadelCourtZakazPage(import.meta.env.CMS_URL)
const publicOrigin = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin
const canonical = resolveCanonicalURL(publicOrigin, '/padel-court-zakaz/', content.page.seo.canonical)
---

<SiteLayout
	site={content.site}
	title={content.page.seo.title ?? content.page.title}
	description={content.page.seo.description ?? content.page.intro}
	canonical={canonical}
	robots={content.page.seo.robots}
	socialImage={content.page.seo.socialImage?.url ?? content.page.hero.media.url}
	structuredData={courtServiceStructuredData(content, publicOrigin, canonical)}
	webmasterVerification={content.site.analytics.vendors.webmasterVerification}
>
	<PadelCourtZakazPage client:load dto={content} publicOrigin={Astro.url.origin} />
</SiteLayout>
