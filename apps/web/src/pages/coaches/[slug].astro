---
import type { CoachDetailDTO } from '@unlim/content-contract'
import { DetailPage } from '../../catalog/DetailPage'
import { CatalogLoadError, loadDetail } from '../../content/loadCatalog'
import PublicErrorPage from '../../components/PublicErrorPage.astro'
import SiteLayout from '../../layouts/SiteLayout.astro'
import { publicRouteError } from '../../lib/publicRouteError'
import { detailStructuredData, resolveCanonicalURL } from '../../seo/structuredData'

export const prerender = false

const slug = Astro.params.slug
if (!slug) throw new CatalogLoadError('Coach slug is required.')
let dto: CoachDetailDTO | null = null
let routeError: ReturnType<typeof publicRouteError> | null = null
try {
  dto = await loadDetail(import.meta.env.CMS_URL, 'coaches', slug) as CoachDetailDTO
} catch (error) {
  routeError = publicRouteError(error)
  Astro.response.status = routeError.status
}
const publicOrigin = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin
const canonical = dto ? resolveCanonicalURL(publicOrigin, Astro.url.pathname, dto.item.seo.canonical) : null
---
{dto && canonical ? <SiteLayout site={dto.site} title={dto.item.seo.title ?? `${dto.item.name} - тренер по паделу | Москва, Новая Рига`} description={dto.item.seo.description ?? dto.item.bio} canonical={canonical} robots={dto.item.seo.robots} socialImage={dto.item.seo.socialImage?.url ?? dto.item.photo.url} structuredData={detailStructuredData(dto, publicOrigin, canonical)} webmasterVerification={dto.site.analytics.vendors.webmasterVerification}><DetailPage client:load dto={dto} /></SiteLayout> : routeError && <SiteLayout title={routeError.title} description={routeError.message} robots="noindex,nofollow"><PublicErrorPage {...routeError} /></SiteLayout>}
