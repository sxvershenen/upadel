---
import SiteLayout from '../../layouts/SiteLayout.astro'
import PhoneMaskSample from '../../playground/PhoneMaskSample.astro'
import { PhoneIcon } from '../../components/ui/ContactIcons'
import { Eye, EyeOff, RotateCcw } from 'lucide-react'
if (!import.meta.env.DEV) return new Response(null, { status: 404 })
const response = await fetch('https://cms.unlimpadel.ru/api/public/homepage')
if (!response.ok) throw new Error('Не удалось загрузить контакты CMS')
const { site } = await response.json()
const phone = String(site.contacts.phoneDisplay)
const digits = Array.from(phone).flatMap((char, index) => /\d/.test(char) ? [index] : [])
const split = digits[Math.max(0, digits.length - 4)] ?? phone.length
const prefix = phone.slice(0, split), suffix = phone.slice(split)
const variants = [
  { id: 'symbols' as const, title: '01 · Символы', description: 'Точки вместо последних цифр. Спокойно, понятно и без декоративного шума.' },
  { id: 'balls' as const, title: '02 · Теннисные мячи', description: 'Четыре маленьких мяча вместо цифр. Клубный характер без поясняющего текста.' },
  { id: 'particles' as const, title: '03 · Частицы', description: 'Цифры рассыпаются на мелкие точки. В футере остаётся лёгкое облако, а не пятно блюра.' },
  { id: 'pixels' as const, title: '04 · Пиксельные фрагменты', description: 'Цифры распадаются на небольшие квадраты. Более графичный и заметный эффект.' },
]
---
<SiteLayout title="Скрытый номер: символы, мячи, частицы — UNLIM playground" robots="noindex-nofollow">
  <main class="phone-lab">
    <div class="lab-intro"><span>UNLIM / ВИЗУАЛЬНЫЙ ПЛЕЙГРАУНД</span><h1>Четыре способа<br /><em>спрятать номер.</em></h1><p>Четыре способа скрыть последние цифры. Глазик раскрывает номер только по нажатию — наведение ничего не меняет.</p></div>
    <div class="lab-controls"><button type="button" data-replay><RotateCcw size={14} />Повторить распад</button><button type="button" data-hide-all>Скрыть все номера</button><span>Это локальное демо. Рабочий сайт и Метрика не меняются.</span></div>
    <div class="phone-variants">
      {variants.map(variant => <section class="phone-variant" data-mask-kind={variant.id} data-revealed="false">
        <div class="variant-description"><h2>{variant.title}</h2><p>{variant.description}</p></div>
        <div class="zoom-sample">
          <span class="sample-label">Увеличенный фрагмент</span>
          <div class="zoom-line"><span class="zoom-number" data-mask-number data-phone-full={phone} data-phone-hidden={`${prefix} — последние четыре цифры скрыты`} aria-label={`${prefix} — последние четыре цифры скрыты`}>{prefix}<PhoneMaskSample kind={variant.id} suffix={suffix} /></span><button type="button" class="eye-button zoom-eye" data-mask-toggle aria-expanded="false" aria-label="Показать полный номер телефона"><Eye size={20} className="eye-show" /><EyeOff size={20} className="eye-hide" /></button></div>
        </div>
        <div class="footer-sample mesh-dark">
          <span class="sample-label">В масштабе футера</span>
          <div class="contact-row"><PhoneIcon size={17} /><div><small>Телефон</small><span class="phone-number" data-mask-number data-phone-full={phone} data-phone-hidden={`${prefix} — последние четыре цифры скрыты`} aria-label={`${prefix} — последние четыре цифры скрыты`}>{prefix}<PhoneMaskSample kind={variant.id} suffix={suffix} /></span></div><button type="button" class="eye-button" data-mask-toggle aria-expanded="false" aria-label="Показать полный номер телефона"><Eye size={16} className="eye-show" /><EyeOff size={16} className="eye-hide" /></button></div>
        </div>
      </section>)}
    </div>
    <p class="lab-note">Сверху — увеличенный фрагмент для сравнения деталей. Снизу — реальный размер карточки. Глазик переключает оба примера в своём варианте.</p>
  </main>
</SiteLayout>
<script>
  const examples = document.querySelectorAll<HTMLElement>('[data-mask-kind]')
  const setRevealed = (example: HTMLElement, revealed: boolean) => {
    example.dataset.revealed = String(revealed)
    example.querySelectorAll<HTMLButtonElement>('[data-mask-toggle]').forEach(button => {
      button.setAttribute('aria-expanded', String(revealed))
      button.setAttribute('aria-label', revealed ? 'Скрыть номер телефона' : 'Показать полный номер телефона')
    })
    example.querySelectorAll<HTMLElement>('[data-mask-number]').forEach(number => number.setAttribute('aria-label', (revealed ? number.dataset.phoneFull : number.dataset.phoneHidden)!))
  }
  document.querySelectorAll<HTMLButtonElement>('[data-mask-toggle]').forEach(button => button.addEventListener('click', () => {
    const example = button.closest<HTMLElement>('[data-mask-kind]')!
    setRevealed(example, example.dataset.revealed !== 'true')
  }))
  document.querySelector('[data-hide-all]')?.addEventListener('click', () => examples.forEach(example => setRevealed(example, false)))
  let replayTimer = 0
  document.querySelector('[data-replay]')?.addEventListener('click', () => {
    window.clearTimeout(replayTimer)
    examples.forEach(example => {
      setRevealed(example, false)
      example.classList.remove('demo-replay')
      if (!['particles', 'pixels'].includes(example.dataset.maskKind!)) return
      void example.offsetWidth
      example.classList.add('demo-replay')
    })
    replayTimer = window.setTimeout(() => examples.forEach(example => example.classList.remove('demo-replay')), 1_200)
  })
</script>
<style>
  .phone-lab{max-width:1400px;margin:auto;padding:44px 36px 60px}.lab-intro>span{font-size:10px;letter-spacing:.13em;color:#7b7b85}.lab-intro h1{font-size:clamp(34px,4.3vw,60px);line-height:1.02;letter-spacing:-.045em;font-weight:600;margin:16px 0 22px}.lab-intro h1 em{font-style:normal;color:#898992}.lab-intro>p{max-width:650px;color:#777780;font-size:14px;line-height:1.5}.lab-controls{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:20px 0;margin:26px 0 32px;border-block:1px solid #dddde2}.lab-controls button{display:inline-flex;align-items:center;gap:7px;border:1px solid #d9d9df;border-radius:10px;padding:11px 14px;font-size:12px;background:white;cursor:pointer}.lab-controls button:first-child{background:#1d1d23;color:white;border-color:#1d1d23}.lab-controls>span{margin-left:auto;color:#92929b;font-size:11px}.phone-variants{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 24px}.variant-description{min-height:68px}.variant-description h2{font-size:18px;font-weight:600}.variant-description p{font-size:12px;line-height:1.5;color:#7c7c84;margin-top:7px;max-width:510px}.zoom-sample,.footer-sample{background:#101217;color:white;border-radius:20px;padding:22px 26px}.zoom-sample{margin-bottom:8px;overflow:hidden}.sample-label{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.09em;color:#ffffff60}.zoom-line{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:16px 0 3px}.zoom-number{font-size:clamp(25px,3vw,43px);line-height:1.4;font-weight:500;letter-spacing:-.045em;white-space:nowrap;font-variant-numeric:tabular-nums}.eye-button{display:grid;place-items:center;width:34px;height:34px;background:#ffffff0b;color:#bfc1ca;border:1px solid #ffffff05;border-radius:10px;cursor:pointer;flex-shrink:0;transition:background .15s,color .15s}.eye-button:hover{background:#ffffff17;color:white}.zoom-eye{width:39px;height:39px;border-radius:12px}.eye-button :global(.eye-hide){display:none}[data-revealed=true] .eye-button :global(.eye-show){display:none}[data-revealed=true] .eye-button :global(.eye-hide){display:block}.footer-sample{padding-top:17px;padding-bottom:19px}.footer-sample .sample-label{margin-bottom:12px}.contact-row{display:flex;gap:12px;align-items:center;width:100%;padding:15px 16px;background:#ffffff0d;border-radius:14px;text-align:left}.contact-row>svg{flex-shrink:0;color:#ffffff70}.contact-row>div{min-width:0}.contact-row small{display:block;font-size:11px;line-height:1.4;color:#ffffff70;margin-bottom:3px}.phone-number{font-size:14px;line-height:1.4;font-weight:500;color:#ffffffdc;white-space:nowrap;font-variant-numeric:tabular-nums}.contact-row .eye-button{margin-left:auto}.lab-note{margin-top:27px;max-width:850px;font-size:12px;line-height:1.5;color:#909099}.phone-lab button:focus-visible{outline:2px solid #a6c943;outline-offset:3px}@media(max-width:850px){.phone-variants{grid-template-columns:1fr;max-width:600px}.phone-lab{padding:30px 18px}.variant-description{min-height:0;margin-bottom:15px}.zoom-number{font-size:clamp(24px,5.7vw,38px)}.zoom-sample,.footer-sample{padding-inline:20px}.lab-controls>span{margin-left:0;width:100%;margin-top:7px}.lab-intro h1{font-size:40px}}@media(prefers-reduced-motion:reduce){.eye-button{transition:none}}
</style>
