---
import SiteLayout from '../../layouts/SiteLayout.astro'
import { PhoneIcon } from '../../components/ui/ContactIcons'
if (!import.meta.env.DEV) return new Response(null, { status: 404 })
const response = await fetch('https://cms.unlimpadel.ru/api/public/homepage')
if (!response.ok) throw new Error('Не удалось загрузить контакты CMS')
const { site } = await response.json()
const phone = String(site.contacts.phoneDisplay)
const digits = Array.from(phone).flatMap((char, index) => /\d/.test(char) ? [index] : [])
const split = digits[Math.max(0, digits.length - 4)] ?? phone.length
const prefix = phone.slice(0, split), suffix = phone.slice(split)
const variants = [
  { id: 'uniform', title: '01 · Равномерный', name: 'Обычный blur', description: 'Одинаковое размытие всех последних цифр. Самый спокойный и предсказуемый вариант.' },
  { id: 'progressive', title: '02 · Нарастающий', name: 'От чёткого к мягкому', description: 'Размытие плавно усиливается к концу номера. Переход от видимых цифр получается мягче.' },
  { id: 'glass', title: '03 · Матовое стекло', name: 'Размытие под плёнкой', description: 'Поверх последних цифр — тонкая светлая дымка. Более заметный эффект, как маленький стеклянный слой.' },
]
---
<SiteLayout title="Виды размытия телефона — UNLIM playground" robots="noindex-nofollow">
  <main class="blur-lab" data-blur-lab>
    <div class="lab-intro"><span>UNLIM / ВИЗУАЛЬНЫЙ ПЛЕЙГРАУНД</span><h1>Три характера<br /><em>одного размытия.</em></h1><p>Сравниваем только внешний вид. Один номер, последние четыре цифры, одинаковые карточки футера. Наведение ничего не раскрывает.</p></div>
    <div class="blur-controls">
      <div class="slider-control"><label for="blur-strength">Сила размытия <output for="blur-strength" data-blur-output>5 px</output></label><input id="blur-strength" data-blur-range type="range" min="1" max="10" step="0.5" value="5" /></div>
      <div class="blur-presets" aria-label="Готовая сила размытия"><button data-blur-preset="3" aria-pressed="false">Лёгкий · 3</button><button data-blur-preset="5" aria-pressed="true">Средний · 5</button><button data-blur-preset="7" aria-pressed="false">Плотный · 7</button></div>
      <button class="original-toggle" data-blur-original aria-pressed="false">Сравнить с исходным</button>
    </div>
    <div class="blur-variants">
      {variants.map(variant => <section class="blur-variant">
        <div class="variant-description"><h2>{variant.title}</h2><p>{variant.description}</p></div>
        <div class="zoom-sample" data-blur-kind={variant.id}>
          <span class="zoom-label">Увеличенный фрагмент</span>
          <span class="zoom-number" aria-label={phone}>{prefix}<span class="blur-tail" aria-hidden="true">{Array.from(suffix).map((char, index) => <span class="blur-char" style={`--digit-weight:${0.25 + (index / Math.max(1, suffix.length - 1)) * .75}`}>{char}</span>)}<span class="glass-layer"></span></span></span>
          <span class="zoom-caption">{variant.name}</span>
        </div>
        <div class="footer-sample mesh-dark" data-blur-kind={variant.id}>
          <span class="sample-label">В масштабе футера</span>
          <div class="contact-row"><span class="contact-icon">↗</span><div><small>Адрес</small><span>{site.contacts.address}</span></div></div>
          <div class="contact-row phone-row"><PhoneIcon size={17} /><div><small>Телефон</small><span class="phone-number" aria-label={phone}>{prefix}<span class="blur-tail" aria-hidden="true">{Array.from(suffix).map((char, index) => <span class="blur-char" style={`--digit-weight:${0.25 + (index / Math.max(1, suffix.length - 1)) * .75}`}>{char}</span>)}<span class="glass-layer"></span></span></span></div><span class="phone-arrow" aria-hidden="true">↗</span></div>
          <div class="contact-row"><span class="contact-icon">@</span><div><small>Email</small><span>{site.contacts.email}</span></div></div>
        </div>
      </section>)}
    </div>
    <p class="lab-note">Верхний пример увеличен для сравнения эффектов. Ниже — тот же эффект в карточке обычного размера. Это локальная визуализация: рабочий сайт и цели Метрики не менялись.</p>
  </main>
</SiteLayout>
<script>
  const lab = document.querySelector<HTMLElement>('[data-blur-lab]')!
  const range = document.querySelector<HTMLInputElement>('[data-blur-range]')!
  const output = document.querySelector<HTMLOutputElement>('[data-blur-output]')!
  const original = document.querySelector<HTMLButtonElement>('[data-blur-original]')!
  const update = () => {
    lab.style.setProperty('--phone-blur', `${range.value}px`)
    output.value = `${range.value} px`
    document.querySelectorAll<HTMLElement>('[data-blur-preset]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.blurPreset === range.value)))
  }
  range.addEventListener('input', update)
  document.querySelectorAll<HTMLButtonElement>('[data-blur-preset]').forEach(button => button.addEventListener('click', () => { range.value = button.dataset.blurPreset!; update() }))
  original.addEventListener('click', () => {
    const showing = lab.classList.toggle('show-original')
    original.setAttribute('aria-pressed', String(showing))
    original.textContent = showing ? 'Вернуть размытие' : 'Сравнить с исходным'
  })
</script>
<style>
  .blur-lab{--phone-blur:5px;max-width:1440px;margin:auto;padding:50px 36px 65px}.lab-intro>span{font-size:10px;letter-spacing:.13em;color:#7b7b85}.lab-intro h1{font-size:clamp(34px,4.3vw,62px);line-height:1.02;letter-spacing:-.045em;font-weight:600;margin:17px 0 24px}.lab-intro h1 em{font-style:normal;color:#898992}.lab-intro>p{max-width:620px;color:#777780;font-size:14px;line-height:1.5}.blur-controls{display:flex;align-items:center;gap:28px;flex-wrap:wrap;padding:22px 0;margin:30px 0 36px;border-block:1px solid #dddde2}.slider-control{width:260px;flex-shrink:0}.slider-control label{display:flex;justify-content:space-between;font-size:12px;font-weight:500;margin-bottom:10px}.slider-control output{font-variant-numeric:tabular-nums;color:#888892}.slider-control input{width:100%;height:5px;accent-color:#25252d;cursor:pointer}.blur-presets{display:flex;gap:5px}.blur-controls button{border:1px solid #d9d9df;border-radius:10px;padding:11px 15px;font-size:12px;background:white;cursor:pointer;white-space:nowrap}.blur-controls button[aria-pressed=true]{background:#1d1d23;color:white;border-color:#1d1d23}.original-toggle{margin-left:auto}.blur-variants{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.variant-description{min-height:101px}.variant-description h2{font-size:18px;font-weight:600}.variant-description p{font-size:12px;line-height:1.5;color:#7c7c84;margin-top:8px;max-width:330px}.zoom-sample{background:#101217;color:white;border-radius:20px;padding:24px 24px 20px;margin-bottom:10px;overflow:hidden}.zoom-label,.sample-label{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.09em;color:#ffffff60}.zoom-number{display:block;font-size:clamp(23px,2.6vw,37px);line-height:1.4;font-weight:500;letter-spacing:-.045em;white-space:nowrap;font-variant-numeric:tabular-nums;margin:21px 0 16px}.zoom-caption{font-size:11px;color:#ffffff5c}.blur-tail{position:relative;display:inline-block;white-space:pre;letter-spacing:inherit}.blur-char{display:inline-block}.blur-tail .glass-layer{display:none}.blur-lab [data-blur-kind=uniform] .blur-tail{filter:blur(var(--phone-blur))}.blur-lab [data-blur-kind=progressive] .blur-char{filter:blur(calc(var(--phone-blur) * var(--digit-weight)))}.blur-lab [data-blur-kind=glass] .glass-layer{display:block;position:absolute;inset:-3px -5px;backdrop-filter:blur(var(--phone-blur));background:linear-gradient(110deg,#ffffff0b,#ffffff1a);border:1px solid #ffffff10;border-radius:7px;box-shadow:0 0 9px #ffffff04}.footer-sample{background:#101217;color:white;border-radius:20px;padding:22px}.sample-label{margin:2px 0 18px}.contact-row{display:flex;gap:12px;align-items:start;width:100%;padding:16px;background:#ffffff0d;border-radius:14px;margin-top:8px;text-align:left}.contact-row>svg{flex-shrink:0;margin-top:2px;color:#ffffff70}.contact-icon{width:17px;flex-shrink:0;color:#ffffff70}.contact-row>div{display:flex;flex-direction:column;min-width:0}.contact-row small{display:block;font-size:11px;line-height:1.4;color:#ffffff70;margin-bottom:3px}.contact-row>div>span{font-size:14px;font-weight:500;color:#ffffffdc;line-height:1.4}.phone-row{align-items:center}.phone-row>svg{margin-top:0}.phone-number{white-space:nowrap;font-variant-numeric:tabular-nums}.phone-arrow{margin-left:auto;font-size:16px;color:#ffffff55}.lab-note{margin-top:28px;max-width:820px;font-size:12px;line-height:1.5;color:#909099}.blur-lab.show-original [data-blur-kind] .blur-tail,.blur-lab.show-original [data-blur-kind] .blur-char{filter:none}.show-original .glass-layer{display:none!important}.blur-controls button:focus-visible{outline:2px solid #9dbc41;outline-offset:3px}@media(max-width:1000px){.blur-variants{grid-template-columns:1fr;max-width:500px}.variant-description{min-height:0;margin-bottom:17px}.blur-variant{margin-bottom:18px}.zoom-number{font-size:36px}.blur-lab{padding:30px 20px}.lab-intro h1{font-size:40px}.original-toggle{margin-left:0}.blur-controls{gap:20px}.blur-controls button{padding:10px 12px}}
</style>
