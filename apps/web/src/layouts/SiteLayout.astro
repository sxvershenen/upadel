---
import '../index.css'
import type { SiteDTO } from '@unlim/content-contract'
import { SiteChromeIsland } from '../components/navigation/SiteChromeIsland'
import { GlobalPageTransition } from '../transition-demo/GlobalPageTransition'

interface Props {
  description?: string
  title?: string
  robots?: string
  canonical?: string | null
  socialImage?: string | null
  webmasterVerification?: string | null
  site?: SiteDTO
}

const {
  description = 'UNLIM RIGA PADEL — премиальный падел-клуб: панорамные корты, тренеры, турниры и абонементы.',
  title = 'UNLIM RIGA PADEL — премиальный падел-клуб',
  robots,
  canonical,
  socialImage,
  webmasterVerification,
  site,
} = Astro.props
const robotsContent = robots?.replace('-', ', ')
const publicOrigin = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin
const resolvedCanonical = canonical?.trim() || new URL(Astro.url.pathname, publicOrigin).toString()
const enableGlobalTransitions = !Astro.url.pathname.startsWith('/transitions/') && !Astro.url.pathname.startsWith('/preview/')
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <link rel="canonical" href={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {webmasterVerification?.trim() && <meta name="yandex-verification" content={webmasterVerification.trim()} />}
    <link rel="preload" href="/fonts/inter-tight/inter-tight-v9-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight/inter-tight-v9-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    {enableGlobalTransitions && <GlobalPageTransition client:load />}
    {site && <SiteChromeIsland client:load site={site} />}
    <div id="swup" data-swup-container>
      <slot />
    </div>
  </body>
  <script is:inline>
    (() => {
      document.documentElement.setAttribute('data-unlim-enhancements', 'true')
      if (window.__unlimSiteEnhancements) return
      window.__unlimSiteEnhancements = true

      let revealObserver = null
      let revealTimer = 0
      const revealSelector = '[data-reveal], [data-reveal-text]'
      const markRevealVisible = (element) => {
        element.setAttribute('data-reveal-visible', 'true')
        revealObserver?.unobserve(element)
      }
      const setupScrollReveals = () => {
        revealTimer = 0
        revealObserver?.disconnect()
        document.documentElement.setAttribute('data-reveal-ready', 'true')
        const targets = Array.from(document.querySelector('#swup')?.querySelectorAll(revealSelector) ?? [])
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          targets.forEach((target) => markRevealVisible(target))
          return
        }
        revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => { if (entry.isIntersecting) markRevealVisible(entry.target) })
        }, { rootMargin: '80px 0px -80px' })
        targets.forEach((target) => {
          const rect = target.getBoundingClientRect()
          if (rect.bottom > -80 && rect.top < window.innerHeight + 80) markRevealVisible(target)
          else revealObserver.observe(target)
        })
      }
      const scheduleScrollReveals = () => {
        const root = document.querySelector('#swup')
        if (!root || (root.querySelector('astro-island') && root.dataset.mainReady !== 'true')) return
        if (revealTimer) window.clearTimeout(revealTimer)
        revealTimer = window.setTimeout(setupScrollReveals, 0)
      }
      const scheduleAfterMainReady = () => scheduleScrollReveals()
      const resetScrollReveals = () => {
        if (revealTimer) window.clearTimeout(revealTimer)
        revealTimer = 0
        revealObserver?.disconnect()
        revealObserver = null
        document.documentElement.removeAttribute('data-reveal-ready')
      }
      scheduleAfterMainReady()
      window.addEventListener('DOMContentLoaded', scheduleAfterMainReady, { once: true })
      document.addEventListener('unlim:main-ready', scheduleAfterMainReady)
      document.addEventListener('astro:after-swap', scheduleAfterMainReady)
      document.addEventListener('astro:before-swap', resetScrollReveals)

      const prefetches = new Set()
      const getIntentTarget = (target) => {
        if (!(target instanceof Element)) return null
        return target.closest('a[href], button[data-prefetch-href]')
      }
      const prefetch = (target) => {
        if (!target) return
        const rawHref = target.getAttribute('href') || target.getAttribute('data-prefetch-href')
        if (!rawHref || rawHref.startsWith('#') || target.hasAttribute('download')) return
        if (target.getAttribute('target') === '_blank' || target.getAttribute('data-no-prefetch') !== null) return
        let url
        try {
          url = new URL(rawHref, document.baseURI)
        } catch {
          return
        }
        if (url.origin !== location.origin || (url.protocol !== 'http:' && url.protocol !== 'https:')) return
        if (url.pathname === location.pathname && url.search === location.search) return
        if (prefetches.has(url.href)) return
        prefetches.add(url.href)
        const link = document.createElement('link')
        link.rel = 'prefetch'
        link.as = 'document'
        link.href = url.href
        link.addEventListener('error', () => link.remove(), { once: true })
        document.head.append(link)
      }
      const onIntent = (event) => prefetch(getIntentTarget(event.target))
      document.addEventListener('pointerover', onIntent, { passive: true })
      document.addEventListener('focusin', onIntent)
      document.addEventListener('touchstart', onIntent, { passive: true })

      const shortWordPattern = /(^|[ \t\r\n])((?:а|и|в|во|не|но|да|к|ко|с|со|у|о|об|от|до|из|за|на|по|под|над|при|без|для|про|через|между|как|так|что|это|же|ли|бы|то))([ \t\r\n]+)(?=\S)/giu
      const skipTypography = 'astro-island,script,style,noscript,textarea,input,select,option,code,pre,[contenteditable="true"],[data-no-typography]'
      const typographText = (node) => {
        if (!node.nodeValue || node.parentElement?.closest(skipTypography)) return
        node.nodeValue = node.nodeValue.replace(shortWordPattern, '$1$2\u00a0')
      }
      const typograph = (root) => {
        if (root.nodeType === Node.TEXT_NODE) {
          typographText(root)
          return
        }
        if (root instanceof Element && root.matches(skipTypography)) return
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
        const nodes = []
        let node
        while ((node = walker.nextNode())) nodes.push(node)
        nodes.forEach(typographText)
      }
      typograph(document.body)
      const pending = new Set()
      let typographyScheduled = false
      const flushTypography = () => {
        typographyScheduled = false
        const nodes = Array.from(pending)
        pending.clear()
        nodes.forEach(typograph)
      }
      const scheduleTypography = () => {
        if (typographyScheduled) return
        typographyScheduled = true
        if ('requestIdleCallback' in window) window.requestIdleCallback(flushTypography, { timeout: 250 })
        else window.setTimeout(flushTypography, 0)
      }
      new MutationObserver((mutations) => {
        if (mutations.some((mutation) => mutation.addedNodes.length > 0)) scheduleScrollReveals()
        mutations.forEach((mutation) => {
          mutation.addedNodes.forEach((node) => pending.add(node))
          if (mutation.type === 'characterData') pending.add(mutation.target)
        })
        scheduleTypography()
      }).observe(document.body, { childList: true, characterData: true, subtree: true })
    })()
  </script>
  <script>
    import { startGsapReveals, stopGsapReveals } from '../lib/gsapReveals'

    // React's effect marker means the commit is finished. Astro's ssr attribute
    // disappears earlier, while React may still be hydrating concurrently.
    const start = () => { void startGsapReveals().catch(() => stopGsapReveals()) }
    document.addEventListener('astro:before-swap', stopGsapReveals)
    document.addEventListener('astro:after-swap', start)
    document.addEventListener('unlim:main-ready', start)
    document.addEventListener('DOMContentLoaded', start, { once: true })
    start()
  </script>
</html>
