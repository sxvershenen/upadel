---
import '../index.css'
import type { SiteDTO } from '@unlim/content-contract'
import { SiteChromeIsland } from '../components/navigation/SiteChromeIsland'
import { GlobalPageTransition } from '../transition-demo/GlobalPageTransition'

interface Props {
  description?: string
  title?: string
  robots?: string
  canonical?: string | null
  socialImage?: string | null
  webmasterVerification?: string | null
  site?: SiteDTO
}

const {
  description = 'UNLIM RIGA PADEL — премиальный падел-клуб: панорамные корты, тренеры, турниры и абонементы.',
  title = 'UNLIM RIGA PADEL — премиальный падел-клуб',
  robots,
  canonical,
  socialImage,
  webmasterVerification,
  site,
} = Astro.props
const robotsContent = robots?.replace('-', ', ')
const publicOrigin = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin
const canonicalPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`
const resolvedCanonical = canonical?.trim() || new URL(canonicalPath, publicOrigin).toString()
const siteSchema = site ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${publicOrigin}/#organization`,
      name: site.brandName,
      url: publicOrigin,
      ...(site.brandLogo?.url ? { logo: site.brandLogo.url } : {}),
      sameAs: site.footer.socialLinks.map(({ url }) => url).filter((url) => /^https?:\/\//i.test(url)),
    },
    {
      '@type': 'SportsActivityLocation',
      '@id': `${publicOrigin}/#club`,
      name: site.brandName,
      url: publicOrigin,
      address: site.contacts.address,
      telephone: site.contacts.phoneValue || undefined,
      email: site.contacts.email || undefined,
      ...(site.contacts.map.latitude || site.contacts.map.longitude
        ? { geo: { '@type': 'GeoCoordinates', latitude: site.contacts.map.latitude, longitude: site.contacts.map.longitude } }
        : {}),
      parentOrganization: { '@id': `${publicOrigin}/#organization` },
    },
  ],
} : null
const siteSchemaJSON = siteSchema ? JSON.stringify(siteSchema).replaceAll('<', '\\u003c') : null
const enableGlobalTransitions = !Astro.url.pathname.startsWith('/transitions/') && !Astro.url.pathname.startsWith('/preview/')
const pageEntrance = Astro.url.pathname === '/gift'
  ? 'gift'
  : /^\/blog\/[^/]+\/?$/.test(Astro.url.pathname)
    ? 'article'
  : /^\/(coaches|tournaments)\/[^/]+\/?$/.test(Astro.url.pathname)
    ? 'detail'
    : undefined
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={site?.brandLogo?.url ?? '/api/media/file/logo-unlim.svg'} />
    <meta name="description" content={description} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <link rel="canonical" href={resolvedCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site?.brandName ?? 'UNLIM RIGA PADEL'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={site?.brandName ?? title} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {siteSchemaJSON && <script type="application/ld+json" is:inline set:html={siteSchemaJSON} />}
    {socialImage && <link rel="preload" href={socialImage} as="image" fetchpriority="high" />}
    {webmasterVerification?.trim() && <meta name="yandex-verification" content={webmasterVerification.trim()} />}
    <link rel="preload" href="/fonts/inter-tight/inter-tight-v9-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight/inter-tight-v9-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    {enableGlobalTransitions && <GlobalPageTransition client:load />}
    {site && <SiteChromeIsland client:load site={site} />}
    <div id="swup" data-swup-container data-page-entrance={pageEntrance}>
      <slot />
    </div>
  </body>
  <script is:inline>
    (() => {
      const pageEntrance = document.querySelector('#swup')?.getAttribute('data-page-entrance')
      if (['gift', 'detail', 'article'].includes(pageEntrance ?? '') && !location.hash) {
        history.scrollRestoration = 'manual'
        window.scrollTo(0, 0)
        window.requestAnimationFrame(() => window.scrollTo(0, 0))
      }
      document.documentElement.setAttribute('data-unlim-enhancements', 'true')
      if (window.__unlimSiteEnhancements) return
      window.__unlimSiteEnhancements = true

      let heroParallaxFrame = 0
      let heroParallaxRoot = null
      let heroParallaxMedia = null
      const updateHeroParallax = () => {
        heroParallaxFrame = 0
        if (!heroParallaxRoot?.isConnected || !heroParallaxMedia?.isConnected) return
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          heroParallaxMedia.style.removeProperty('--hero-parallax-scale')
          return
        }
        const rect = heroParallaxRoot.getBoundingClientRect()
        const progress = Math.max(0, Math.min(1, -rect.top / Math.max(1, rect.height)))
        const mobile = window.matchMedia('(max-width: 767px)').matches
        const endScale = mobile ? 1.34 : 1.28
        heroParallaxMedia.style.setProperty('--hero-parallax-scale', String(1.08 + (endScale - 1.08) * progress))
      }
      const scheduleHeroParallax = () => {
        if (!heroParallaxFrame) heroParallaxFrame = window.requestAnimationFrame(updateHeroParallax)
      }
      const setupHeroParallax = () => {
        heroParallaxMedia?.style.removeProperty('--hero-parallax-scale')
        heroParallaxRoot = document.querySelector('[data-hero-parallax-root]')
        heroParallaxMedia = Array.from(heroParallaxRoot?.querySelectorAll('[data-hero-parallax-media]') ?? [])
          .find((media) => window.getComputedStyle(media).display !== 'none') ?? null
        scheduleHeroParallax()
      }
      window.addEventListener('scroll', scheduleHeroParallax, { passive: true })
      window.addEventListener('resize', setupHeroParallax, { passive: true })
      window.visualViewport?.addEventListener('resize', scheduleHeroParallax, { passive: true })
      document.addEventListener('astro:after-swap', setupHeroParallax)
      setupHeroParallax()

      let revealObserver = null
      let revealTimer = 0
      const markRevealVisible = (element) => {
        if (element.matches('[data-gsap-reveal]')) element.setAttribute('data-gsap-reveal-visible', 'true')
        else element.setAttribute('data-reveal-visible', 'true')
        revealObserver?.unobserve(element)
      }
      const selectSectionReveals = (allTargets) => {
        const scopes = allTargets.filter((target) => target.getAttribute('data-gsap-reveal-scope') === 'true')
        const leafScopes = scopes.filter((scope) => !scope.querySelector('[data-gsap-reveal-scope="true"]'))
        const selectedScopes = new Set(leafScopes)
        return allTargets.filter((target) => {
          if (target.parentElement?.closest('[data-page-enter-owner="true"], [data-page-enter="content"]')) return false
          if (target.parentElement?.closest('[data-gsap-reveal-boundary="true"]')) return false
          if (target.parentElement?.closest('[data-gsap-reveal-scope="true"]')) return selectedScopes.has(target)
          if (selectedScopes.has(target) || target.getAttribute('data-gsap-reveal-boundary') === 'true') return true
          return !target.querySelector('[data-gsap-reveal-boundary="true"], [data-gsap-reveal]')
        })
      }
      const setupScrollReveals = () => {
        revealTimer = 0
        revealObserver?.disconnect()
        const root = document.querySelector('#swup')
        const cssTargets = Array.from(root?.querySelectorAll('[data-reveal], [data-reveal-text]') ?? [])
        const allSectionTargets = Array.from(root?.querySelectorAll('[data-gsap-reveal]') ?? [])
        const sectionTargets = selectSectionReveals(allSectionTargets)
        const sectionSet = new Set(sectionTargets)
        allSectionTargets.forEach((target) => {
          if (sectionSet.has(target)) target.setAttribute('data-gsap-reveal-owner', 'true')
          else target.removeAttribute('data-gsap-reveal-owner')
        })
        const targets = [...cssTargets, ...sectionTargets]
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          targets.forEach((target) => markRevealVisible(target))
          document.documentElement.setAttribute('data-reveal-ready', 'true')
          document.documentElement.setAttribute('data-gsap-reveal-ready', 'true')
          return
        }
        revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.boundingClientRect.width > 0 && entry.boundingClientRect.height > 0) markRevealVisible(entry.target)
          })
        }, { rootMargin: '80px 0px -80px' })
        targets.forEach((target) => {
          const rect = target.getBoundingClientRect()
          if (rect.width > 0 && rect.height > 0 && rect.bottom > -80 && rect.top < window.innerHeight + 80) markRevealVisible(target)
          else revealObserver.observe(target)
        })
        // Do not briefly hide visible SSR text when enabling scroll reveals.
        document.documentElement.setAttribute('data-reveal-ready', 'true')
        document.documentElement.setAttribute('data-gsap-reveal-ready', 'true')
      }
      const scheduleScrollReveals = () => {
        const root = document.querySelector('#swup')
        if (!root) return
        if (revealTimer) window.clearTimeout(revealTimer)
        revealTimer = window.setTimeout(setupScrollReveals, 0)
      }
      const scheduleAfterMainReady = () => scheduleScrollReveals()
      const resetScrollReveals = () => {
        if (revealTimer) window.clearTimeout(revealTimer)
        revealTimer = 0
        revealObserver?.disconnect()
        revealObserver = null
        document.documentElement.removeAttribute('data-reveal-ready')
        document.documentElement.removeAttribute('data-gsap-reveal-ready')
      }
      scheduleAfterMainReady()
      window.addEventListener('DOMContentLoaded', scheduleAfterMainReady, { once: true })
      document.addEventListener('unlim:main-ready', scheduleAfterMainReady)
      document.addEventListener('astro:after-swap', scheduleAfterMainReady)
      document.addEventListener('astro:before-swap', resetScrollReveals)

      const prefetches = new Set()
      const getIntentTarget = (target) => {
        if (!(target instanceof Element)) return null
        return target.closest('a[href], button[data-prefetch-href]')
      }
      const prefetch = (target) => {
        if (!target) return
        const rawHref = target.getAttribute('href') || target.getAttribute('data-prefetch-href')
        if (!rawHref || rawHref.startsWith('#') || target.hasAttribute('download')) return
        if (target.getAttribute('target') === '_blank' || target.getAttribute('data-no-prefetch') !== null) return
        let url
        try {
          url = new URL(rawHref, document.baseURI)
        } catch {
          return
        }
        if (url.origin !== location.origin || (url.protocol !== 'http:' && url.protocol !== 'https:')) return
        if (url.pathname === location.pathname && url.search === location.search) return
        if (prefetches.has(url.href)) return
        prefetches.add(url.href)
        const link = document.createElement('link')
        link.rel = 'prefetch'
        link.as = 'document'
        link.href = url.href
        link.addEventListener('error', () => link.remove(), { once: true })
        document.head.append(link)
      }
      const onIntent = (event) => prefetch(getIntentTarget(event.target))
      document.addEventListener('pointerover', onIntent, { passive: true })
      document.addEventListener('focusin', onIntent)
      document.addEventListener('touchstart', onIntent, { passive: true })
      document.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
        const target = getIntentTarget(event.target)
        const rawHref = target?.getAttribute('href')
        if (!rawHref || rawHref.startsWith('#') || target?.hasAttribute('download') || target?.getAttribute('target') === '_blank') return
        try {
          const url = new URL(rawHref, document.baseURI)
          if (url.origin !== location.origin || (url.pathname === location.pathname && url.search === location.search)) return
          document.documentElement.dataset.routeTransition = 'loading'
        } catch {
          // Invalid links keep native browser behavior without an indicator.
        }
      }, true)

      const shortWordPattern = /(^|[ \t\r\n])((?:а|и|в|во|не|но|да|к|ко|с|со|у|о|об|от|до|из|за|на|по|под|над|при|без|для|про|через|между|как|так|что|это|же|ли|бы|то))([ \t\r\n]+)(?=\S)/giu
      const skipTypography = 'astro-island,script,style,noscript,textarea,input,select,option,code,pre,[contenteditable="true"],[data-no-typography]'
      const typographText = (node) => {
        if (!node.nodeValue || node.parentElement?.closest(skipTypography)) return
        node.nodeValue = node.nodeValue.replace(shortWordPattern, '$1$2\u00a0')
      }
      const typograph = (root) => {
        if (root.nodeType === Node.TEXT_NODE) {
          typographText(root)
          return
        }
        if (root instanceof Element && root.matches(skipTypography)) return
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
        const nodes = []
        let node
        while ((node = walker.nextNode())) nodes.push(node)
        nodes.forEach(typographText)
      }
      typograph(document.body)
      const pending = new Set()
      let typographyScheduled = false
      const flushTypography = () => {
        typographyScheduled = false
        const nodes = Array.from(pending)
        pending.clear()
        nodes.forEach(typograph)
      }
      const scheduleTypography = () => {
        if (typographyScheduled) return
        typographyScheduled = true
        if ('requestIdleCallback' in window) window.requestIdleCallback(flushTypography, { timeout: 250 })
        else window.setTimeout(flushTypography, 0)
      }
      const prepareNativeImage = (image) => {
        if (!(image instanceof HTMLImageElement) || image.dataset.progressiveNative !== 'loading') return
        const settle = () => { image.dataset.progressiveNative = 'loaded' }
        const revealDecoded = () => {
          if (typeof image.decode !== 'function') return settle()
          image.decode().catch(() => {}).then(settle)
        }
        if (image.complete && image.naturalWidth > 0) revealDecoded()
        else {
          image.addEventListener('load', revealDecoded, { once: true })
          image.addEventListener('error', settle, { once: true })
        }
      }
      document.querySelectorAll('img[data-progressive-native]').forEach(prepareNativeImage)
      new MutationObserver((mutations) => {
        if (mutations.some((mutation) => mutation.addedNodes.length > 0)) scheduleScrollReveals()
        mutations.forEach((mutation) => {
          mutation.addedNodes.forEach((node) => {
            pending.add(node)
            if (node instanceof HTMLImageElement) prepareNativeImage(node)
            else if (node instanceof Element) node.querySelectorAll('img[data-progressive-native]').forEach(prepareNativeImage)
          })
          if (mutation.type === 'characterData') pending.add(mutation.target)
        })
        scheduleTypography()
      }).observe(document.body, { childList: true, characterData: true, subtree: true })
    })()
  </script>
</html>
