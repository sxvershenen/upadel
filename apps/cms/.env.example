DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/unlim
PAYLOAD_SECRET=replace-with-a-long-random-secret
PAYLOAD_ADMIN_ROUTE=/urp-panel
ADMIN_USERNAME=URP
ADMIN_EMAIL=admin@example.test
# Keep the real password only in the ignored local/production env file.
ADMIN_PASSWORD=replace-with-a-long-random-password
# Set true only for an explicit password rotation.
ADMIN_UPDATE_PASSWORD=false
PUBLIC_WEB_URL=http://localhost:4321
PUBLIC_CMS_URL=http://localhost:3000
# Optional public origin for projected media/forms, e.g. the LAN web proxy.
PUBLIC_CONTENT_URL=
PREVIEW_SECRET=replace-with-a-separate-long-random-secret
LEAD_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
ANALYTICS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# 32+ random characters; deployment scheduler calls POST /api/internal/analytics-maintenance every 15 minutes.
ANALYTICS_JOB_SECRET=replace-with-a-separate-32-character-secret
# Keep notification credentials only in the server environment; never commit real values.
TELEGRAM_BOT_TOKEN=replace-with-a-rotated-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
VK_ACCESS_TOKEN=replace-with-a-rotated-community-token
VK_PEER_ID=replace-with-vk-peer-id
